Package: sundialr
Type: Package
Title: An Interface to 'SUNDIALS' Ordinary Differential Equation (ODE) Solvers
Version: 0.2.2
Date: 2026-11-22
Authors@R: c(
    person("Satyaprakash", "Nayak", email = "satyaprakash.nayak@gmail.com", role = c("aut", "cre","cph"), comment = c(ORCID = "0000-0001-7225-1317")),
